# Configuration publique de l'application Web Firebase (aucune clé de compte de service).
# Sans ces variables, l'application fonctionne exclusivement sur cet appareil.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Uniquement en développement local, jamais en production.
VITE_USE_FIREBASE_EMULATORS=false
