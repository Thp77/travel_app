{
  "name": "travel-budget-tracker",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/domain.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-travel-app \"node --test tests/rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test:shared": "firebase emulators:exec --only auth,firestore --project demo-travel-app \"playwright test --config playwright.shared.config.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "firebase": "^13.0.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.33.0",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^2.0.0"
  }
}
